{
  "name": "malaysian-manglish-nlp-vscode",
  "displayName": "Malaysian Manglish NLP",
  "description": "Sentiment analysis, normalization, NER, and translation for Manglish (Malaysian colloquial Malay) text directly in VS Code",
  "version": "0.2.0",
  "publisher": "ZafranYusof",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zafranyusof/malaysian-manglish-nlp"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "manglish",
    "malay",
    "malaysia",
    "nlp",
    "sentiment",
    "normalization",
    "ner",
    "translation",
    "bm"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "manglish.analyzeSelection",
        "title": "Manglish: Analyze Selection",
        "icon": "$(search)"
      },
      {
        "command": "manglish.normalize",
        "title": "Manglish: Normalize",
        "icon": "$(replace-all)"
      },
      {
        "command": "manglish.translate",
        "title": "Manglish: Translate",
        "icon": "$(globe)"
      },
      {
        "command": "manglish.sentiment",
        "title": "Manglish: Sentiment Analysis",
        "icon": "$(feedback)"
      },
      {
        "command": "manglish.ner",
        "title": "Manglish: Named Entity Recognition",
        "icon": "$(tag)"
      },
      {
        "command": "manglish.checkApi",
        "title": "Manglish: Check API Status",
        "icon": "$(plug)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "manglish.submenu",
          "group": "manglish@1"
        }
      ],
      "manglish.submenu": [
        {
          "command": "manglish.analyzeSelection",
          "group": "1_analyze@1"
        },
        {
          "command": "manglish.normalize",
          "group": "1_analyze@2"
        },
        {
          "command": "manglish.translate",
          "group": "1_analyze@3"
        },
        {
          "command": "manglish.sentiment",
          "group": "1_analyze@4"
        },
        {
          "command": "manglish.ner",
          "group": "1_analyze@5"
        }
      ]
    },
    "submenus": [
      {
        "id": "manglish.submenu",
        "label": "Manglish NLP"
      }
    ],
    "keybindings": [
      {
        "command": "manglish.analyzeSelection",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorHasSelection"
      },
      {
        "command": "manglish.normalize",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "editorTextFocus"
      },
      {
        "command": "manglish.translate",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Manglish NLP",
      "properties": {
        "manglish.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the Manglish NLP API server"
        },
        "manglish.autoNormalizeOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically normalize Manglish shortforms on file save"
        },
        "manglish.requestTimeout": {
          "type": "number",
          "default": 10000,
          "description": "API request timeout in milliseconds"
        },
        "manglish.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Underline Manglish shortforms with hints"
        },
        "manglish.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Show sentiment info on hover"
        },
        "manglish.enableStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show detected language in status bar"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {}
}
